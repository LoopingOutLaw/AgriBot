<?xml version='1.0'?>
<sdf version="1.9">
  <model name="custom_iris_with_ardupilot_treatment">
    <include>
      <uri>model://iris_with_standoffs_and_cam_treatment</uri>
    </include>

    <!--
      visual markers for debugging
      - blade root    - teal
      - blade tip     - orange
      - blade cp      - yellow
      - blade forward - red
      - blade upward  - blue
    -->
