    <!-- Crops with proper spacing for infected plants -->
    <!-- Healthy crops: green (0.1 0.6 0.1) -->
    <!-- Infected crops: brown (0.6 0.4 0.1) -->
    <!-- Spaced out infected crops in random clusters -->
    
    <!-- Cluster 1 (top-left) -->
    <model name="crop_1">
