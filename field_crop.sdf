    <!-- Survey Drone for crop scanning -->
    <include>
      <uri>model://custom_iris_with_ardupilot</uri>
      <name>survey_drone</name>
      <pose>0 -8 0.5 0 0 0</pose>  <!-- Positioned at first launch pad -->
      <plugin name="survey_controller" filename="libArduPilotPlugin.so">
        <filter>survey_drone</filter>
        <imu_rate>1000</imu_rate>
      </plugin>
    </include>

    <!-- Treatment/Spray Drone for targeted spraying -->
    <include>
      <uri>model://iris_with_ardupilot</uri>
      <name>treatment_drone</name>
      <pose>4 -8 0.5 0 0 0</pose>  <!-- Positioned at second launch pad -->
      <plugin name="treatment_controller" filename="libArduPilotPlugin.so">
        <filter>treatment_drone</filter>
        <imu_rate>1000</imu_rate>
      </plugin>
    </include>

    <!-- Area boundary markers for 2-acre area -->
    <model name="area_boundary">
      <static>true</static>
      <link name="link">
        <!-- North boundary of crop area -->
        <visual name="crop_north">
          <cast_shadows>0</cast_shadows>
          <pose>35 50 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>50 0.1 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0 1 0 0.8</ambient>
            <diffuse>0 1 0 0.8</diffuse>
          </material>
        </visual>
        <!-- South boundary of crop area -->
        <visual name="crop_south">
          <cast_shadows>0</cast_shadows>
          <pose>35 10 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>50 0.1 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0 1 0 0.8</ambient>
            <diffuse>0 1 0 0.8</diffuse>
          </material>
        </visual>
        <!-- East boundary of crop area -->
        <visual name="crop_east">
          <cast_shadows>0</cast_shadows>
          <pose>60 30 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 40 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0 1 0 0.8</ambient>
            <diffuse>0 1 0 0.8</diffuse>
          </material>
        </visual>
        <!-- West boundary of crop area -->
        <visual name="crop_west">
          <cast_shadows>0</cast_shadows>
          <pose>10 30 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 40 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0 1 0 0.8</ambient>
            <diffuse>0 1 0 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
