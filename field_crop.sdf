<?xml version="1.0"?>
<sdf version="1.9">
  <world name="agribot_farm">
    <physics name="fast_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Systems -->
    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.7 0.9 1.0</background>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <shadows>1</shadows>
    </scene>

    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.95 0.95 0.9 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="axes">
      <static>1</static>
      <link name="link">
        <visual name="r">
          <cast_shadows>0</cast_shadows>
          <pose>5 0 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>10 0.01 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 0.8</ambient>
            <diffuse>1 0 0 0.8</diffuse>
            <emissive>1 0 0 0.8</emissive>
            <specular>0.5 0.5 0.5 0.8</specular>
          </material>
        </visual>
        <visual name="g">
          <cast_shadows>0</cast_shadows>
          <pose>0 5 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 10 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0 1 0 0.8</ambient>
            <diffuse>0 1 0 0.8</diffuse>
            <emissive>0 1 0 0.8</emissive>
            <specular>0.5 0.5 0.5 0.8</specular>
          </material>
        </visual>
        <visual name="b">
          <cast_shadows>0</cast_shadows>
          <pose>0 0 5.1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.01 10</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 1 0.8</ambient>
            <diffuse>0 0 1 0.8</diffuse>
            <emissive>0 0 1 0.8</emissive>
            <specular>0.5 0.5 0.5 0.8</specular>
          </material>
        </visual>
        <sensor name="navsat_sensor" type="navsat">
          <always_on>1</always_on>
          <update_rate>1</update_rate>
        </sensor>
      </link>
    </model>

    <!-- Expanded ground plane for larger area -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <script>
              <uri>model://ground_plane</uri>
              <name>Gazebo/DryDirt</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- No Fly Zone Boundary Markers -->
    <model name="no_fly_zone_boundary">
      <static>true</static>
      <link name="link">
        <!-- North boundary -->
        <visual name="north_boundary">
          <cast_shadows>0</cast_shadows>
          <pose>25 45 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>50 0.1 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 0.8</ambient>
            <diffuse>1 0 0 0.8</diffuse>
          </material>
        </visual>
        <!-- South boundary -->
        <visual name="south_boundary">
          <cast_shadows>0</cast_shadows>
          <pose>25 5 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>50 0.1 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 0.8</ambient>
            <diffuse>1 0 0 0.8</diffuse>
          </material>
        </visual>
        <!-- East boundary -->
        <visual name="east_boundary">
          <cast_shadows>0</cast_shadows>
          <pose>50 25 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 40 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 0.8</ambient>
            <diffuse>1 0 0 0.8</diffuse>
          </material>
        </visual>
        <!-- West boundary -->
        <visual name="west_boundary">
          <cast_shadows>0</cast_shadows>
          <pose>0 25 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 40 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 0.8</ambient>
            <diffuse>1 0 0 0.8</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Launch Pads with H markers -->
    <model name="launchpad_1">
      <static>true</static>
      <link name="link">
        <!-- Landing pad base -->
        <visual name="pad_base">
          <cast_shadows>0</cast_shadows>
          <pose>0 -8 0.01 0 0 0</pose>
          <geometry>
            <box>
              <size>1.83 1.83 0.02</size> <!-- 6ft x 6ft -->
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
        <!-- H marker - horizontal bars -->
        <visual name="h_bar1">
          <cast_shadows>0</cast_shadows>
          <pose>0 -8 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 1.2 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>
        <visual name="h_bar2">
          <cast_shadows>0</cast_shadows>
          <pose>-0.5 -8 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 0.6 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>
        <visual name="h_bar3">
          <cast_shadows>0</cast_shadows>
          <pose>0.5 -8 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 0.6 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="launchpad_2">
      <static>true</static>
      <link name="link">
        <!-- Landing pad base -->
        <visual name="pad_base">
          <cast_shadows>0</cast_shadows>
          <pose>4 -8 0.01 0 0 0</pose>
          <geometry>
            <box>
              <size>1.83 1.83 0.02</size> <!-- 6ft x 6ft -->
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
        <!-- H marker - horizontal bars -->
        <visual name="h_bar1">
          <cast_shadows>0</cast_shadows>
          <pose>4 -8 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 1.2 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>
        <visual name="h_bar2">
          <cast_shadows>0</cast_shadows>
          <pose>3.5 -8 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 0.6 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>
        <visual name="h_bar3">
          <cast_shadows>0</cast_shadows>
          <pose>4.5 -8 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>0.1 0.6 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ground Control Station (GCS) area -->
    <model name="gcs_area">
      <static>true</static>
      <link name="link">
        <visual name="gcs_platform">
          <cast_shadows>0</cast_shadows>
          <pose>2 -15 0.01 0 0 0</pose>
          <geometry>
            <box>
              <size>4 2 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.9 1</ambient>
            <diffuse>0.6 0.6 0.9 1</diffuse>
          </material>
        </visual>
        <!-- GCS label -->
        <visual name="gcs_label">
          <cast_shadows>0</cast_shadows>
          <pose>2 -15 0.02 0 0 0</pose>
          <geometry>
            <box>
              <size>2 0.5 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 2 Acre Agricultural Area with Crops -->
    <!-- Healthy crops: green (0.1 0.6 0.1) -->
    <!-- Infected crops: brown (0.6 0.4 0.1) scattered throughout -->
    <!-- Grid: 25 crops (X) x 20 crops (Y), spacing: 2.0m between crops -->
    <!-- Total area: 50m x 40m = 2000m² ≈ 0.5 acres per quadrant -->

    <!-- Additional crops near launch pad for continuous field -->
    <model name="crop_near_1"><static>true</static><pose>-2 -8 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.3 0.3 0.6</size></box></geometry></collision></link></model>
    <model name="crop_near_2"><static>true</static><pose>0 -6 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.3 0.3 0.6</size></box></geometry></collision></link></model>
    <model name="crop_near_3"><static>true</static><pose>2 -8 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.3 0.3 0.6</size></box></geometry></collision></link></model>
    <model name="crop_near_4"><static>true</static><pose>4 -6 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.3 0.3 0.6</size></box></geometry></collision></link></model>
    <model name="crop_near_5"><static>true</static><pose>6 -8 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.3 0.3 0.6</size></box></geometry></collision></link></model>
    <model name="crop_near_6"><static>true</static><pose>8 -6 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.3 0.3 0.6</size></box></geometry></collision></link></model>
    <model name="crop_near_7"><static>true</static><pose>10 -8 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.3 0.3 0.6</size></box></geometry></collision></link></model>
    <model name="crop_near_8"><static>true</static><pose>-2 -6 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.3 0.3 0.6</size></box></geometry></collision></link></model>
    <model name="crop_near_9"><static>true</static><pose>0 -4 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.3 0.3 0.6</size></box></geometry></collision></link></model>
    <model name="crop_near_10"><static>true</static><pose>2 -4 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.3 0.3 0.6</size></box></geometry></collision></link></model>
    <model name="crop_near_11"><static>true</static><pose>4 -4 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.3 0.3 0.6</size></box></geometry></collision></link></model>
    <model name="crop_near_12"><static>true</static><pose>6 -4 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.3 0.3 0.6</size></box></geometry></collision></link></model>
    <model name="crop_near_13"><static>true</static><pose>8 -4 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.3 0.3 0.6</size></box></geometry></collision></link></model>
    <model name="crop_near_14"><static>true</static><pose>10 -4 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual><collision name="collision"><geometry><box><size>0.3 0.3 0.6</size></box></geometry></collision></link></model>

    <!-- Fill gaps between crops for continuous field - Row -6 to 0 -->
    <model name="crop_fill_1"><static>true</static><pose>-1 -6 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual></link></model>
    <model name="crop_fill_2"><static>true</static><pose>1 -6 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual></link></model>
    <model name="crop_fill_3"><static>true</static><pose>3 -6 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual></link></model>
    <model name="crop_fill_4"><static>true</static><pose>5 -6 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual></link></model>
    <model name="crop_fill_5"><static>true</static><pose>7 -6 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual></link></model>
    <model name="crop_fill_6"><static>true</static><pose>9 -6 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual></link></model>
    <model name="crop_fill_7"><static>true</static><pose>-1 -4 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual></link></model>
    <model name="crop_fill_8"><static>true</static><pose>1 -4 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual></link></model>
    <model name="crop_fill_9"><static>true</static><pose>3 -4 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual></link></model>
    <model name="crop_fill_10"><static>true</static><pose>5 -4 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual></link></model>
    <model name="crop_fill_11"><static>true</static><pose>7 -4 0.3 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 0.6</size></box></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material></visual></link></model>
